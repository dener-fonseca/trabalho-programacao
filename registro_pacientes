# Classe que representa um estado e será um nodo na lista encadeada.

class Estado:
  def __init__(self, sigla, nomeEstado):
    self.sigla = sigla
    self.nomeEstado = nomeEstado
    self.proximo = None
    
# Classe que representa uma lista encadeada que receberá os estados.

class ListaEncadeada:
  def __init__(self):
    self.head = None

  def inserirInicio(self, sigla, nomeEstado):
    novo = Estado(sigla, nomeEstado)
    novo.proximo = self.head
    self.head = novo

  def imprimir(self):
    atual = self.head
    
    while atual is not None:
      print(atual.sigla, end = " --> ")
      
      atual = atual.proximo
      
    print("None")
    
# Classe que representa a tabela hash e coloca os estados em listas encadeadas dentro das posições da tabela.

class TabelaHash:
  def __init__(self):
    self.tabelaHash = [None] * 10
    
    for i in range(10):
      self.tabelaHash[i] = ListaEncadeada()
      
  def funcaoHash(self, sigla):
    sigla = sigla.upper()
    
    if sigla == "DF":
      return 7
    
    char1 = ord(sigla[0])
    char2 = ord(sigla[1])
    
    posicao = (char1 + char2) % 10
    
    return posicao
    
  def inserir(self, sigla, nomeEstado):
    
    posicao = self.funcaoHash(sigla)
    
    self.tabelaHash[posicao].inserirInicio(sigla, nomeEstado)
    
  def imprimir(self):
    for i in range(10):
      print(f"Posição {i}: ", end = "")
      
      self.tabelaHash[i].imprimir()

